{
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://rastahale-eae5d.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/__/firebase/:path*",
      "destination": "https://rastahale-eae5d.firebaseapp.com/__/firebase/:path*"
    },
    {
      "source": "/((?!\\.well-known/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ]
}
