# Supabase
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=

# Client-side (safe to expose)
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-side ONLY — never prefix with VITE_
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=

# ============================================================
# Firebase (login Google na web + push notifications web/PWA)
#
# Passo a passo completo em FIREBASE-SETUP.md.
# O login Google no app ANDROID não usa estas chaves — ele usa o
# android/app/google-services.json. Estas chaves são só para a web.
# ============================================================

# As 6 chaves abaixo vêm do Firebase Console:
#   Project settings → General → Your apps → Web app (</>) → SDK setup and configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Push notifications web (PWA). Firebase Console:
#   Project settings → Cloud Messaging → Web Push certificates → Generate key pair
# (sem ela, o push web fica desativado — o resto do app funciona normal)
VITE_FIREBASE_VAPID_KEY=

# ============================================================
# Stripe — assinaturas de plano (Checkout + Portal + Webhook)
#
# Passo a passo completo em STRIPE-SETUP.md.
# Enquanto estiver testando, use SEMPRE as chaves de TESTE (sk_test_/pk_test_).
# Chaves live cobram cartões reais e não têm rollback.
# ============================================================

# Publishable key (pode ficar no bundle web). Dashboard → Developers → API keys.
VITE_STRIPE_PUBLISHABLE_KEY=

# --- As chaves abaixo ficam APENAS nas Edge Functions do Supabase, ---
# --- nunca em código do cliente. Configure com:                     ---
#   supabase functions secrets set STRIPE_SECRET_KEY=sk_test_...
#   supabase functions secrets set STRIPE_WEBHOOK_SECRET=whsec_...
#   supabase functions secrets set APP_URL=https://seu-dominio.com
# Aqui deixamos como referência do que precisa existir no ambiente das funções:
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
APP_URL=http://localhost:8080
